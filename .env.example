# 监听地址。生产建议只监听回环地址，由外层反向代理转发。
HOST=127.0.0.1

# 与 DSH 无关的独立端口。
PORT=8731

# 生产环境填外部 HTTPS 地址；OAuth 回调会用它拼接。
# 例如 https://feishu.example.com
PUBLIC_BASE_URL=http://127.0.0.1:8731

# 外层反向代理时设为 1，让 Fastify 信任 X-Forwarded-*。
TRUST_PROXY=0

# 默认关闭逐请求日志，避免聊天轮询刷屏；调试时设为 1。
REQUEST_LOGGING=0

# 可选：32 字节随机值，base64。
# 不填时首次开发会在 ~/.web-feishu-client/master.key 自动生成，生产建议显式配置并备份。
APP_SECRET_KEY=

# 可选；默认 ~/.web-feishu-client
# 注意不要写 ~，需要绝对路径或相对当前目录的路径
# DATA_DIR=/home/you/.web-feishu-client
